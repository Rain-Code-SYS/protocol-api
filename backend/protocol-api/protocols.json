        "data_type": "int",
        "byte_length": null,
        "description": null
      }
    ]
  },
  "trig_protocol_4": {
    "protocol_id": "trig_protocol_4",
    "name": "Lung Contact Flag",
    "version": "1.0",
    "format_type": "bitfield",
    "delimiter": null,
    "bit_width": 1,
    "fields": [
      {
        "name": "lung_hit",
        "data_type": "int",
