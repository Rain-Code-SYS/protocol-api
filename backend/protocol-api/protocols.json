{
  "trig_protocol_1": {
    "protocol_id": "trig_protocol_1",
    "name": "Simulation Practice Settings",
    "version": "1.1",
    "format_type": "bitfield",
    "delimiter": null,
    "bit_width": 7,
    "fields": [
      {
        "name": "age",
        "data_type": "int",
        "byte_length": null,
        "bit_offset": 5,
        "bit_width": 2,
        "max_value": 2,
        "description": "Pediatric=0, Adult=1, Geriatric=2"
      },
      {
        "name": "difficulty",
        "data_type": "int",
        "byte_length": null,
        "bit_offset": 3,
        "bit_width": 2,
        "max_value": 2,
        "description": "Easy=0, Medium=1, Hard=2"
      },
      {
        "name": "case_type",
        "data_type": "int",
        "byte_length": null,
        "bit_offset": 2,
        "bit_width": 1,
        "max_value": 1,
        "description": "Basic=0, Emer/Trauma=1"
      },
      {
        "name": "practice_mode",
        "data_type": "int",
        "byte_length": null,
        "bit_offset": 0,
        "bit_width": 2,
        "max_value": 2,
        "description": "Tutorial=0, Guide=1, Blind=2"
      }
    ]
  },
  "trig_protocol_2": {
