        "description": "Board time in milliseconds"
      },
      {
        "name": "enc1",
        "data_type": "int",
        "byte_length": null,
        "description": "Encoder 1 raw count"
      },
      {
        "name": "enc2",
        "data_type": "int",
        "byte_length": null,
        "description": "Encoder 2 raw count"
      },
      {
        "name": "enc3",
        "data_type": "int",
        "byte_length": null,
        "description": "Encoder 3 raw count"
      }
    ]
  },
  "trig_protocol_3": {
    "protocol_id": "trig_protocol_3",
    "name": "Haptic Control Command Output",
    "version": "1.0.0",
